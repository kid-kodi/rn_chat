# ============================================
# React Native Chat App - Environment Configuration
# ============================================

# Base API URL for the backend server
# Development (local): Use your machine's local IP address
# Production: Use your production domain
# Format: http://IP:PORT or https://domain.com
BASE_API_URL=http://192.168.1.2:5000

# Server IP address and port
# Must match BASE_API_URL without the protocol
# Format: IP:PORT or domain.com
SERVER_IP=192.168.1.2:5000

# ============================================
# Production Configuration (commented examples)
# ============================================
# Uncomment and update these when deploying to production
# BASE_API_URL=https://api.yourdomain.com
# SERVER_IP=api.yourdomain.com

# ============================================
# Setup Instructions
# ============================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. For local development:
#    - Find your machine's local IP:
#      - macOS/Linux: ifconfig | grep "inet "
#      - Windows: ipconfig
#    - Update BASE_API_URL and SERVER_IP with your local IP
#    - Make sure PORT matches your backend server PORT
#
# 3. For production:
#    - Update with your production domain
#    - Ensure HTTPS is enabled
#
# 4. NEVER commit the .env file to version control!
#
# ============================================
